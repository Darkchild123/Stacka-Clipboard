<?xml version="1.0" encoding="utf-8"?>
<!--
  Stacka Clipboard — MSIX package manifest (Microsoft Store build)

  Identity values come from Partner Center (Product identity page) and MUST
  match it exactly, or the submission is rejected.

  Version: four parts, and the LAST part must be 0 for Store submissions.
  Bump the third part for each new submission (1.0.1.0, 1.0.2.0, …).

  NOT DECLARED HERE — the "Paste from Stacka" Explorer entry.
  MSIX virtualizes the registry, so the keys the app writes at runtime never
  reach the real Explorer. Declaring a context menu in a package requires a
  COM CLSID implementing IExplorerCommand, i.e. a native DLL — out of scope
  for this app. The Store build therefore relies on the other five triggers
  (double right-click, middle-click, side button, Ctrl+right-click, overlay
  button) plus the hotkey, all of which work in Explorer anyway. The GitHub
  installer build keeps the shell entry.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <Identity
    Name="CosmasNwachukwu.StackaClipboard"
    Publisher="CN=5772570D-DDFD-4FD2-967F-B4ADBD34BC29"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Stacka Clipboard</DisplayName>
    <PublisherDisplayName>Cosmas Nwachukwu</PublisherDisplayName>
    <Description>Clipboard manager that keeps what you copy and pastes it back at your cursor.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 17763 (1809) is the floor for the desktop extensions used here. -->
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <!-- Required by every packaged desktop (full-trust) app. It is a
         RESTRICTED capability: Partner Center asks you to justify it at
         submission — see STORE-NOTES.md. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <Application Id="StackaClipboard"
                 Executable="Stacka.exe"
                 EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="Stacka Clipboard"
        Description="Clipboard manager that keeps what you copy and pastes it back at your cursor."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Start with Windows. Replaces the HKCU Run key, which MSIX
             virtualizes. The user can still switch it off in
             Settings > Apps > Startup. -->
        <desktop:Extension
          Category="windows.startupTask"
          Executable="Stacka.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="StackaClipboardStartup"
            Enabled="true"
            DisplayName="Stacka Clipboard" />
        </desktop:Extension>
      </Extensions>

    </Application>
  </Applications>
</Package>
